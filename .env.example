# tell configuration. Copy to .env and fill in what you need; every variable has a
# default in tell/config.py, so an empty file is valid. Never commit real values.

# SQLAlchemy URL of the Postgres database (local dev server or Neon in production).
DATABASE_URL=
# User-Agent for SEC EDGAR requests; the SEC requires a real contact address.
SEC_USER_AGENT=
# User-Agent sent to every non-SEC source.
TELL_HTTP_USER_AGENT=
# Slack incoming webhook that receives the daily digest (secret).
SLACK_WEBHOOK_URL=
# GitHub token used by the GitHub org collector (secret; provided by Actions in CI).
GITHUB_TOKEN=
# GitHub repo (owner/name) that receives JSONL events and the static site.
TELL_DATA_REPO=
# Fine-grained PAT with contents:write on TELL_DATA_REPO only (secret).
TELL_DATA_PUSH_TOKEN=
# Access token of the customer's HubSpot private app, read by `tell crm hubspot` (secret; never in the repo or Actions logs).
HUBSPOT_PRIVATE_APP_TOKEN=
# Base URL of the HubSpot API; only tests change it.
HUBSPOT_API_BASE=
# Number of job boards fetched in parallel.
TELL_POLL_CONCURRENCY=
# Requests per second against SEC EDGAR (keep at or below half the SEC ceiling).
TELL_RATE_EDGAR_RPS=
# Requests per second against Google News RSS (undocumented API; stay slow).
TELL_RATE_NEWS_RPS=
# Requests per second per ATS vendor host.
TELL_RATE_ATS_RPS=
# Maximum number of new domains processed per discovery run.
TELL_DISCOVERY_BUDGET=
# Requests per second during ATS discovery.
TELL_DISCOVERY_RPS=
# Domains discovered at once (threads); all of them share the TELL_DISCOVERY_RPS budget.
TELL_DISCOVERY_CONCURRENCY=
# Wall-clock minutes per discovery run; no new domain starts after it, the rest wait for the next run.
TELL_DISCOVERY_MAX_MINUTES=
# Public base URL of the static site and api/v0 JSON (GitHub Pages).
TELL_BASE_URL=
# Optional API key for the FastAPI service, used by tell-mcp when present (secret).
TELL_API_KEY=
# Base URL of the FastAPI v1 service; tell-mcp uses it only together with TELL_API_KEY.
TELL_API_URL=
# Public URL of the code repo; every published page links to the commit that produced it.
TELL_REPO_URL=
# Public URL of the tell-data repo (JSONL events, posting snapshots, the static site).
TELL_DATA_REPO_URL=
# Prefilled Google Form link for feedback; {signal_id}, {domain}, {verdict} and {watchlist} are substituted.
TELL_FEEDBACK_FORM_URL=
# Published-as-CSV URL of the feedback form's response sheet, read by `tell intake feedback-sync` (secret; tell-private Actions secret only, never logged).
TELL_FEEDBACK_CSV_URL=
# Google Form link where people ask for domains to be watched (Slack digest footer).
TELL_INTAKE_FORM_URL=
# Published-as-CSV URL of the intake form's response sheet, read by `tell intake sync` (secret; tell-private Actions secret only, never logged).
TELL_INTAKE_CSV_URL=
# Score at which score_crossed_threshold fires (upward crossing).
TELL_ALERT_THRESHOLD=
# IANA timezone used to decide which run sends the Slack digest.
TELL_SLACK_TZ=
# Local hour (0-23): the first ingest run at or after this local hour sends the digest.
TELL_SLACK_DIGEST_HOUR=
# Password gating the Streamlit review page (secret).
TELL_REVIEW_PASSWORD=
# Timeout in seconds for every outbound HTTP request.
TELL_HTTP_TIMEOUT_S=
# "true" marks every run of this process as a manual intervention (runs.notes.manual), the anchor of "weeks unattended"; ingest.yml sets it on workflow_dispatch only, never on the schedule.
TELL_RUN_MANUAL=
# Environment name: dev, test, ci or prod.
TELL_ENV=
